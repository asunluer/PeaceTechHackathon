# Local development values only. Set unique secrets for any shared deployment.
POSTGRES_DB=guardia
POSTGRES_USER=guardia
POSTGRES_PASSWORD=replace-with-a-long-random-password
GUARDIA_ENVIRONMENT=development
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-separate-random-secret-of-at-least-32-bytes
STORAGE_ENCRYPTION_KEY=replace-with-exactly-32-random-chars
# Required for production worker: a filtering proxy that blocks private, loopback,
# link-local, and metadata destinations at connection time.
CAPTURE_PROXY_URL=
# Cross-origin API access for the Flutter app (mobile and web dev builds). Defaults to
# "*"; the mobile client authenticates with a Bearer token it attaches itself rather
# than a cookie, so a permissive origin list here is not a CSRF risk. Narrow this to
# your app's real origin(s), comma-separated, before any shared/production deployment.
CORS_ORIGINS=*
